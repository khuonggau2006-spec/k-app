      "Bash(ls -la \"/c/Users/admin/AppData/Local/Temp/claude/C--Users-admin-Desktop-TH-c-t-p-K-app/d443c4bf-05ad-4bf9-b1b8-6907ac39f0dd/tasks/\" | grep b8lkw300g)",
      "Bash(dotnet build *)",
      "Bash(dotnet list *)",
      "Bash(xargs cat)",
      "Bash(dotnet remove *)",
      "Bash(powershell -NoProfile -Command 'Get-Process -Name dotnet -ErrorAction SilentlyContinue | Where-Object { $_.MainWindowTitle -eq '\\\\'''\\\\'' } | Select-Object Id,StartTime')",
