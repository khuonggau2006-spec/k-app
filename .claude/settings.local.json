      "Bash(powershell -NoProfile -Command \"Stop-Process -Id 3184 -Force; Start-Sleep -Seconds 1; Get-NetTCPConnection -LocalPort 5299 -ErrorAction SilentlyContinue\")",
      "PowerShell(flutter doctor -v)",
