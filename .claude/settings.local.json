      "Bash(ls \"/d/flutter/bin/\" 2>&1 | head -20)",
      "Bash(sleep 15 && cat /tmp/flutter_run.log)",
      "Bash(powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 8765 -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique\")",
      "Bash(powershell -NoProfile -Command \"Stop-Process -Id 16088 -Force -ErrorAction SilentlyContinue; Start-Sleep -Seconds 1; Get-NetTCPConnection -LocalPort 8765 -ErrorAction SilentlyContinue\")",
      "Bash(rm -rf /c/FlutterPathTest *)",
      "PowerShell(Get-Process | Where-Object { $_.ProcessName -match 'dotnet|VBCSCompiler|dart|flutter' } | Select-Object Id,ProcessName,Path)"
