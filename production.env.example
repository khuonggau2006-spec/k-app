# Copy file này thành ".env.production" trên server thật, điền giá trị thật vào, rồi chạy:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# TUYỆT ĐỐI không commit ".env.production" (đã có trong .gitignore) - đây là nơi chứa toàn bộ
# secret của hệ thống production.

# --- PostgreSQL ---------------------------------------------------------------
# Đặt mật khẩu mạnh, khác hẳn giá trị dev "taskmgmt_pass". Có thể tạo nhanh bằng:
#   openssl rand -base64 32
POSTGRES_USER=taskmgmt_user
POSTGRES_PASSWORD=
POSTGRES_DB=taskmgmt_db

# --- Redis ---------------------------------------------------------------------
REDIS_PASSWORD=

# --- JWT -------------------------------------------------------------------------
# Chuỗi ký JWT - PHẢI ngẫu nhiên, tối thiểu 32 ký tự, khác hoàn toàn giá trị dev.
#   openssl rand -base64 48
# Đổi giá trị này sẽ làm mọi access token/refresh token đang tồn tại bị vô hiệu ngay lập tức
# (tất cả người dùng bị đăng xuất) - chỉ đổi khi thật sự cần (vd: nghi ngờ bị lộ secret).
JWT_SECRET=

# --- File storage (S3-compatible: AWS S3 thật, hoặc tự host MinIO trên server) --
# Nếu dùng AWS S3: STORAGE_ENDPOINT để trống hoặc để endpoint AWS mặc định theo region,
# STORAGE_ACCESS_KEY/SECRET_KEY là access key IAM (quyền tối thiểu: đọc/ghi đúng 1 bucket).
# Nếu tự host MinIO trên cùng server: chạy thêm service minio trong compose (xem docker-compose.yml
# bản dev để tham khảo cấu hình), rồi trỏ STORAGE_ENDPOINT về "http://minio:9000".
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_NAME=taskmgmt-attachments
STORAGE_USE_SSL=true

# --- Firebase (push notification thật) ------------------------------------------
# 1. Vào Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# 2. Tải file JSON về, đặt trên SERVER (không phải máy dev) ở đường dẫn bất kỳ ngoài thư mục repo,
#    ví dụ /etc/taskmgmt/firebase-service-account.json
# 3. Set quyền chỉ đọc, chỉ user chạy docker mới đọc được: chmod 600
# 4. Điền đường dẫn đó vào biến dưới đây (docker-compose.prod.yml sẽ mount file này vào container
#    dưới dạng read-only, KHÔNG copy vào image).
FIREBASE_CREDENTIALS_HOST_PATH=/etc/taskmgmt/firebase-service-account.json
